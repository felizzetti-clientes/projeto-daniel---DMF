NEXT_PUBLIC_SITE_URL=
# WhatsApp comercial, só dígitos com DDI, ex.: 55 + DDD + número (o botão só aparece se definido)
NEXT_PUBLIC_WHATSAPP=
# Envio do formulário via Resend (https://resend.com). Sem estes valores o formulário informa indisponibilidade.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
